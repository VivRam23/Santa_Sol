---
import '../styles/global.css';
import site from '../content/site.json';
import copy from '../content/booking.json';
import beachData from '../content/beaches.json';
import { asset } from '../lib/assets';
import { hasMarker, plain } from '../lib/rich';

interface Props {
  /** Which page: the homepage carries the FAQ data and preloads the hero photo. */
  page?: 'home' | 'book';
  title?: string;
  description?: string;
}
const { page = 'home', title = site.seo.title, description = site.seo.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = asset('images', site.seo.ogImage.replace('/images/', ''));
const hero = page === 'home' ? asset('images', copy.hero.image) : null;

// Structured data: the business, each open session date as an Event, and the FAQ.
// FAQ answers still holding a [TBD] marker are left out until they are final.
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: plain(copy.hero.subhead),
  url: Astro.site?.href,
  telephone: site.whatsappNumber,
  sameAs: [site.instagramUrl, site.photographerUrl],
  areaServed: ['Tamarindo', 'Playa Grande', 'Flamingo'].map((name) => ({ '@type': 'Place', name })),
  priceRange: `$${site.price}`,
};
const bookUrl = new URL(site.bookingUrl, Astro.site).href;
const events = beachData.beaches.flatMap((b) =>
  b.dates.map((dt) => ({
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: `${site.name} sunset session, ${b.name}`,
    startDate: dt.iso,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    location: { '@type': 'Place', name: `${b.name}, Guanacaste, Costa Rica` },
    organizer: { '@type': 'Organization', name: site.name, url: Astro.site?.href },
    offers: {
      '@type': 'Offer',
      price: site.price,
      priceCurrency: site.currency,
      url: `${bookUrl}#${b.id}`,
    },
  })),
);
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.faq.items
    .filter((i) => !hasMarker(i.a))
    .map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
const jsonLd = JSON.stringify(page === 'home' ? [business, ...events, faq] : [business, ...events]);
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="only light" />
    <!-- Light only: the logo files are dark ink on linen, so the site never switches to dark mode. -->
    <meta name="theme-color" content="#F3EDE4" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage.src, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preload" href="/fonts/Fraunces-Soft.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Jost.ttf" as="font" type="font/ttf" crossorigin />
    {hero && <link rel="preload" href={hero.src} as="image" fetchpriority="high" />}

    <script type="application/ld+json" set:html={jsonLd} />

    <!-- TODO(analytics): paste the analytics snippet (GA4 via GTM, or Plausible) here. Events are already wired. -->
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-card focus:bg-raised focus:px-4 focus:py-3">Skip to content</a>
    <slot />
    <script>
      import { trackClicks } from '../lib/track';
      trackClicks();
    </script>
  </body>
</html>
