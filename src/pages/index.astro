---
// Santa & Sol booking page. Section order follows Peitho's 12-section copy and the approved v3 design.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import IncludedStrip from '../components/IncludedStrip.astro';
import Session from '../components/Session.astro';
import WhyBook from '../components/WhyBook.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Photographer from '../components/Photographer.astro';
import Dates from '../components/Dates.astro';
import Offer from '../components/Offer.astro';
import Faq from '../components/Faq.astro';
import ClosingBand from '../components/ClosingBand.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <IncludedStrip />
    <Session />
    <WhyBook />
    <HowItWorks />
    <Photographer />
    <Dates />
    <Offer />
    <Faq />
    <ClosingBand />
  </main>
  <Footer />
  <StickyBar />
</Base>
