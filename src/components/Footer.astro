---
import Logo from './Logo.astro';
import copy from '../content/booking.json';
import site from '../content/site.json';
---
<footer class="mx-auto flex max-w-[1296px] flex-col items-start gap-3.5 px-4 pb-28 pt-10 text-small text-muted md:flex-row md:flex-wrap md:items-center md:justify-between md:gap-x-12 md:gap-y-6 md:px-[72px] md:pb-16 md:pt-12">
  <Logo file="santa-sol-horizontal-web.svg" alt={copy.header.logoAlt} class="w-[240px] md:h-[60px] md:w-auto" />
  <p>
    {copy.footer.line}
    <span aria-hidden="true"> · </span><a href={site.photographerUrl}>{site.photographerDomain}</a>
    <span aria-hidden="true"> · </span>Instagram <a href={site.instagramUrl}>{site.instagramHandle}</a>
    <span aria-hidden="true"> · </span>Questions? WhatsApp <a href={site.whatsappLink} data-event="phone_click" data-section="footer">{site.whatsappNumber}</a>
  </p>
</footer>
