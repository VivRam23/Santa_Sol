---
// Phones only: the booking button stays in thumb reach while scrolling.
import copy from '../content/booking.json';
import site from '../content/site.json';
---
<div class="fixed inset-x-0 bottom-0 z-20 flex items-center justify-between gap-3 border-t border-line bg-raised px-4 py-2.5 shadow-[0_-6px_20px_rgba(46,38,33,0.08)] md:hidden">
  <span class="text-small leading-[1.3] text-muted">{copy.stickyBar.lead}</span>
  <a class="btn flex-none px-4 py-3 text-xs tracking-[0.08em]" href={site.bookingUrl} data-event="cta_click" data-section="sticky_bar">{copy.stickyBar.button}</a>
</div>
