---
import Logo from './Logo.astro';
import copy from '../content/booking.json';
---
<!-- Stripe band 1 of 3: the top border -->
<div aria-hidden="true" class="stripe h-3 md:h-[18px]"></div>
<header class="mx-auto flex max-w-[1296px] items-center justify-center px-4 py-3.5 md:justify-between md:px-[72px] md:py-5">
  <a href="#top" class="block" aria-label={copy.header.logoAlt}>
    <Logo file="santa-sol-horizontal.svg" alt={copy.header.logoAlt} class="w-[220px] md:hidden" />
    <Logo file="santa-sol-stacked.svg" alt={copy.header.logoAlt} class="hidden h-[104px] w-auto md:block" />
  </a>
  <!-- On phones the sticky bar does this job, so the header keeps the logo only. -->
  <a class="btn hidden md:inline-flex" href="#dates" data-event="cta_click" data-section="header">{copy.header.button}</a>
</header>
