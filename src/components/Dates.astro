---
import Headline from './Headline.astro';
import Photo from './Photo.astro';
import Rich from './Rich.astro';
import WaitlistForm from './WaitlistForm.astro';
import copy from '../content/booking.json';
import site from '../content/site.json';
const d = copy.dates;
---
<section id="dates" aria-labelledby="dates-title">
  <!-- The one wide photo band (people in it, so nothing overlaps it). Brand v1.1: crop no wider than 2:1. -->
  <div class="aspect-[4/3] overflow-hidden bg-raised md:aspect-[2/1]">
    <Photo file={d.bandImage} alt={d.bandAlt} cover sizes="100vw" />
  </div>

  <div class="mx-auto flex max-w-[1296px] flex-col gap-5 px-4 pb-14 pt-10 md:gap-8 md:px-[72px] md:pb-24 md:pt-[72px]">
    <div class="flex flex-col gap-5 md:flex-row md:flex-wrap md:gap-x-[72px] md:gap-y-10 md:rounded-card md:border md:border-line md:bg-raised md:p-14">
      <div class="flex flex-col gap-4 md:min-w-[320px] md:flex-1">
        <Headline id="dates-title" text={d.headline} accent={d.headlineAccent} class="text-display-md md:text-display-lg" />
        <p class="md:text-body-lg">{d.lead}</p>
        <div class="flex flex-col gap-1 border-y border-line py-4 md:mt-2 md:border-b-0 md:pb-0 md:pt-5">
          <p class="signoff md:text-[22px] md:leading-[1.25]">{d.santaOptional}</p>
          <p class="under text-body">{d.santaOptionalUnder}</p>
        </div>
      </div>

      <div class="flex min-w-0 flex-col gap-5 md:flex-[1.4]">
        <div class="overflow-x-auto rounded-card border border-line bg-raised md:bg-transparent">
          <table class="w-full border-collapse text-body">
            <caption class="sr-only">Session dates and beaches</caption>
            <thead class="hidden md:table-header-group">
              <tr>
                {d.columns.map((c) => (
                  <th scope="col" class="eyebrow border-b border-line px-4 py-3.5 text-left">{c}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {d.rows.map((r, i) => (
                <tr class:list={['flex flex-wrap justify-between gap-x-3 px-4 py-3.5 md:table-row md:p-0', i < d.rows.length - 1 && 'border-b border-line md:border-0']}>
                  <th scope="row" class:list={['text-left font-semibold md:px-4 md:py-3.5', i < d.rows.length - 1 && 'md:border-b md:border-line']}>
                    {r.date}<span class="md:hidden"> · {r.beach}</span>
                  </th>
                  <td class:list={['hidden md:table-cell md:px-4 md:py-3.5', i < d.rows.length - 1 && 'md:border-b md:border-line']}>{r.beach}</td>
                  <td class:list={['md:px-4 md:py-3.5', i < d.rows.length - 1 && 'md:border-b md:border-line']}><Rich text={r.window} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>{d.pattern}</p>
        <p class="under">{d.note}</p>
        <div>
          <a class="btn w-full md:w-auto" href={site.bookingUrl} data-event="cta_click" data-section="dates">{d.button}</a>
        </div>
      </div>
    </div>

    <WaitlistForm />
  </div>
</section>
