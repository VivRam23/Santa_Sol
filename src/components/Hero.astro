---
import Headline from './Headline.astro';
import Photo from './Photo.astro';
import copy from '../content/booking.json';
import site from '../content/site.json';
const h = copy.hero;
---
<section id="top" class="mx-auto grid max-w-[1296px] gap-5 px-4 pb-12 pt-3 md:grid-cols-[minmax(0,1fr)_minmax(300px,600px)] md:gap-x-14 md:gap-y-6 md:px-[72px] md:pb-20 md:pt-6">
  <div class="flex flex-col gap-5 md:col-start-1 md:row-start-1 md:self-end md:gap-6">
    <p class="eyebrow">{h.eyebrow}</p>
    <Headline as="h1" text={h.headline} accent={h.headlineAccent} class="text-[40px] leading-[1.02] md:text-display-xl" />
  </div>

  <!-- The one arch on the page, with stripe band 2 of 3 as its horizon -->
  <div class="sunset-rise md:col-start-2 md:row-span-2 md:row-start-1 md:self-center">
    <div class="arch aspect-[358/340] md:aspect-square">
      <Photo file={h.image} alt={h.imageAlt} cover priority objectPosition="55% 66%" sizes="(min-width: 768px) 600px, 100vw" />
    </div>
    <div aria-hidden="true" class="stripe h-[18px] md:h-6"></div>
  </div>

  <div class="flex flex-col gap-6 md:col-start-1 md:row-start-2 md:self-start">
    <p class="text-body-lg md:max-w-[520px]">{h.subhead}</p>
    <div class="flex flex-col gap-2 md:items-start">
      <a class="btn btn-lg" href={site.bookingUrl} data-event="cta_click" data-section="hero">{h.button}</a>
      <p class="under text-center md:text-left">{h.under}</p>
    </div>
  </div>
</section>
