---
import Headline from './Headline.astro';
import Photo from './Photo.astro';
import Rich from './Rich.astro';
import copy from '../content/booking.json';
const s = copy.session;
---
<!-- Phones: headline, photo, text. Desktop: photo left, headline and text right (Santa faces the text). -->
<section class="mx-auto grid max-w-[1296px] gap-5 px-4 py-14 md:grid-cols-[minmax(280px,620px)_minmax(0,1fr)] md:gap-x-20 md:gap-y-5 md:px-[72px] md:py-24">
  <Headline text={s.headline} accent={s.headlineAccent} class="text-[44px] leading-[1.02] md:col-start-2 md:row-start-1 md:self-end md:text-[58px] md:leading-none" />
  <div class="md:col-start-1 md:row-span-2 md:row-start-1 md:self-center">
    <Photo file={s.image} alt={s.imageAlt} class="w-full" sizes="(min-width: 768px) 620px, 100vw" />
  </div>
  <div class="flex flex-col gap-5 text-body md:col-start-2 md:row-start-2 md:self-start md:text-body-lg">
    <p><Rich text={s.body} /></p>
    <h3 class="mt-2 text-2xl leading-[1.15] md:mt-3 md:text-[28px] md:leading-[1.1]">{s.cardsHeader}</h3>
    <p>{s.cardsBody}</p>
  </div>
</section>
